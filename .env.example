# Shared local development configuration. Never use these values in production.
ATLAS_ENV=development
DATABASE_URL=postgresql+asyncpg://atlas:atlas_local_only@localhost:54329/atlas
AUTH_MODE=development
AUTH_ISSUER=https://dev.atlas.local
AUTH_AUDIENCE=atlas-api
AUTH_DEV_SECRET=replace-with-at-least-32-random-characters
AUTH_JWKS_URL=
CORS_ORIGINS=http://localhost:3000
API_URL=http://localhost:8000
ATLAS_DEV_AUTH_SECRET=replace-with-the-same-at-least-32-random-characters
OBJECT_STORE_ROOT=.local-object-store
UPLOAD_SIGNING_SECRET=replace-with-at-least-32-random-characters
PARSER_MAX_BYTES=1048576
CHUNK_TARGET_CHARS=900
CHUNK_OVERLAP_CHARS=120
MAX_CHUNKS_PER_DOCUMENT=500
EMBEDDING_PROVIDER=deterministic-local
EMBEDDING_MODEL=atlas-local-hash-embedding
EMBEDDING_MODEL_VERSION=2026-08-27
EMBEDDING_DIMENSION=32
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_TEXT_CHARS=4000
SEMANTIC_SEARCH_DEFAULT_TOP_K=5
SEMANTIC_SEARCH_MAX_TOP_K=20
LEXICAL_SEARCH_LANGUAGE=english
HYBRID_SEARCH_RRF_K=60
HYBRID_SEARCH_CANDIDATE_MULTIPLIER=4
RETRIEVAL_CONFIG_VERSION=phase5-postgres-fts-rrf-v1
